  "contraindication_rules": [
    {
      "rule_id": "RULE-RX-001",
      "class": "beta_lactam",
      "severity": "HIGH",
      "description": "Cross-reactivity between Penicillin allergens and Beta-Lactam / Cephalosporin agents.",
      "remediation": "Withhold beta-lactam agent. Substitute with non-cross-reactive alternative (e.g. Macrolide, Fluoroquinolone, or Glycopeptide depending on indication)."
    },
    {
      "rule_id": "RULE-RX-002",
      "class": "nsaid",
      "severity": "HIGH",
      "description": "Cross-reactivity and bronchospasm risk across NSAID class in sensitized patients.",
      "remediation": "Avoid all COX inhibitors. Consider Acetaminophen or non-pharmacological analgesic."
    },
    {
      "rule_id": "RULE-RX-003",
      "class": "opioid",
      "severity": "CRITICAL",
      "description": "Opioid hypersensitivity or severe respiratory depression contraindication.",
      "remediation": "Halt opioid administration. Re-evaluate multimodal non-opioid pain regimen."
    }
  ],
